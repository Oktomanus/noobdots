        "break",


               {
            "type": "custom",
            "key": "   \u001b[38;5;108mMake \u001b[38;5;80mdreams \u001b[38;5;173mcome \u001b[38;5;74mtrue\u001b[0m"
             },

        

        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────80HDBB──────────┐"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "  Date ",
            "keyColor": "magenta",
            "format": "{3}.{2}.{1}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────┘"
        },

//        {
//            "type": "colors"
//        },

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
 
    ]
