{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$(ls ~/.config/fastfetch/ascii/*.txt | shuf -n 1)"
        
        
    },
    "modules": [
        
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───Aesthetic Soul───┐"
        },
        {
            "type": "os",
            "key": " ┌ ┌ ",
            "keyColor": "yellow",
            "format": "{2}"
        },
        {
            "type": "packages",
            "key": " │ ├󰏖 ",
            "keyColor": "yellow",
            "format": "{1}"
        },
        {
            "type": "shell",
            "key": " └ └ ",
            "keyColor": "yellow",
            "format": "{1}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;80m  "
        },
        {
            "type": "wm",
            "key": " ┌ ┌ ",
            "keyColor": "blue",
            "format": "{1}"
        },

        {
            "type": "de",
            "key": " DE ",
            "keyColor": "blue",
            "format": "{1}"
            
        },
        {
            "type": "lm",
            "key": " │ ├󰍂 ",
            "keyColor": "blue",
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": " └ └ ",
            "keyColor": "blue",
            "format": "{1}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────┘"
        },
        
