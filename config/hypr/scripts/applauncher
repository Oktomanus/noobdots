#!/bin/bash

# Temporary file for applications list
TEMP_FILE=$(mktemp)
trap 'rm -f "$TEMP_FILE"' EXIT

# Optimized function to parse .desktop file
parse_desktop_file() {
    local file="$1"
    local name="" exec="" terminal=false in_desktop_entry=false hidden=false

    while IFS= read -r line; do
        # Fast section check without regex
        case "$line" in
            '[Desktop Entry]')
                in_desktop_entry=true
                continue
                ;;
            '['*']')
                in_desktop_entry=false
                continue
                ;;
        esac

        # Only process lines in [Desktop Entry] section
        if [[ "$in_desktop_entry" == true ]]; then
            case "$line" in
                Name=*)
                    [[ -z "$name" ]] && name="${line#Name=}"
                    ;;
                Exec=*)
                    if [[ -z "$exec" ]]; then
                        exec="${line#Exec=}"
                        # Remove field codes like %f, %u etc.
                        exec="${exec// %f/}" exec="${exec// %F/}" exec="${exec// %u/}" exec="${exec// %U/}"
                        exec="${exec// %d/}" exec="${exec// %D/}" exec="${exec// %n/}" exec="${exec// %N/}"
                        exec="${exec// %i/}" exec="${exec// %c/}" exec="${exec// %k/}" exec="${exec// %v/}" exec="${exec// %m/}"
                        exec="${exec//\"/}"    # remove any stray quotes
                        exec="${exec%% }"      # remove trailing space
                    fi
                    ;;
                Terminal=true)
                    terminal=true
                    ;;
                Hidden=true|NoDisplay=true)
                    hidden=true
                    return  # Early exit for hidden apps
                    ;;
            esac
        fi
    done < "$file"

    # Add terminal wrapper for terminal applications
    if [[ "$terminal" == true && "$exec" != *"foot"* && "$exec" != *"alacritty"* && "$exec" != *"kitty"* && "$exec" != *"gnome-terminal"* ]]; then
        exec="foot -e $exec"
    fi

    # Output if valid and not hidden
    if [[ -n "$name" && -n "$exec" && "$hidden" == false ]]; then
        printf "%s\t%s\n" "$name" "$exec"
    fi
}

echo "Scanning applications..." >&2

# Optimized find with more exclusions
declare -a desktop_files
mapfile -t desktop_files < <(find /usr/share/applications ~/.local/share/applications /var/lib/flatpak/exports/share/applications \
    -type f -name "*.desktop" ! -name "*mimeinfo*" ! -name ".*" ! -name "*-usercreated*" 2>/dev/null)

# Fast sorting with C locale
{
    for desktop_file in "${desktop_files[@]}"; do
        [[ -r "$desktop_file" && -s "$desktop_file" ]] && parse_desktop_file "$desktop_file"
    done
} | LC_ALL=C sort -u > "$TEMP_FILE"

echo "Found $(wc -l < "$TEMP_FILE") applications" >&2

# Show selection menu
selected=$(cut -f1 "$TEMP_FILE" | fzf \
    --height=100% \
    --reverse \
    --prompt="  " \
    --border \
    --preview-window=hidden \
    --pointer="➤"
)

# Launch selected application
if [[ -n "$selected" ]]; then
    command=$(awk -F'\t' -v app="$selected" '$1 == app {print $2; exit}' "$TEMP_FILE")
    if [[ -n "$command" ]]; then
        echo "Launching: $selected" >&2
        # Robust launch — supports commands with arguments and special chars
        setsid nohup env bash -lc "cd ~ && exec $command" >/dev/null 2>&1 &
        disown
    fi
fi
