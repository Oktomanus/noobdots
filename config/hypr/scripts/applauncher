#/bin/bash
# Directories with .desktop files
DESKTOP_DIRS=( /usr/share/applications ~/.local/share/applications /var/lib/flatpak/exports/share/applications )

# Cache file path
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/applauncher.list"
COUNT_FILE="${CACHE_FILE}.count"

mkdir -p "$(dirname "$CACHE_FILE")"

# Temporary file for the current session
tempfile=$(mktemp)
declare -A apps

# Count the number of .desktop files
current_count=$(find "${DESKTOP_DIRS[@]}" -type f -name '*.desktop' 2>/dev/null | wc -l)

# Check if cache needs to be updated
needs_update=false
if [[ ! -f "$CACHE_FILE" || ! -f "$COUNT_FILE" ]]; then
    needs_update=true
else
    old_count=$(<"$COUNT_FILE")
    [[ "$old_count" -ne "$current_count" ]] && needs_update=true
fi

# If the cache is outdated — recreate it
if $needs_update; then
    : > "$tempfile"
    for dir in "${DESKTOP_DIRS[@]}"; do
        [[ -d "$dir" ]] || continue
        while IFS= read -r -d '' file; do
            output=$(awk -F= '
                /^Name=/ && !name_set { name=$2; name_set=1 }
                /^Exec=/ && !exec_set { exec=$2; exec_set=1 }
                END {
                    gsub(/ *%[fFuUdDnNickvm]/, "", exec)
                    gsub(/ +$/, "", exec)
                    if (name && exec) print name "\t" exec
                }
            ' "$file")
            name=$(cut -f1 <<< "$output")
            cmd=$(cut -f2 <<< "$output")
            if [[ -n "$name" && -n "$cmd" && -z "${apps[$name]}" ]]; then
                apps["$name"]="$cmd"
                echo -e "$name\t$cmd" >> "$tempfile"
            fi
        done < <(find "$dir" -type f -name '*.desktop' -print0 2>/dev/null)
    done
    mv "$tempfile" "$CACHE_FILE"
    echo "$current_count" > "$COUNT_FILE"
    tempfile="$CACHE_FILE" # read the list directly from cache
else
    cp "$CACHE_FILE" "$tempfile"
fi

# Selection menu via fzf
selected=$(cut -f1 "$tempfile" | fzf \
    --height=40% \
    --reverse \
    --prompt="▶ " \
    --border \
    --ansi
)

# Run the selected application
if [[ -n "$selected" ]]; then
    cmd=$(awk -F'\t' -v sel="$selected" '$1 == sel { print $2; exit }' "$tempfile")
    setsid $cmd >/dev/null 2>&1 &
fi

rm "$tempfile"
